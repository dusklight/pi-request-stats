{
  "name": "pi-request-stats",
  "version": "1.0.0",
  "description": "Pi extension reporting per-request time split into thinking/answer/tool-call generation vs tool execution, per-phase tokens-per-second, compaction counts, and estimated request cost.",
  "type": "module",
  "license": "MIT",
  "author": "dusklight",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "stats",
    "timing",
    "tokens-per-second",
    "throughput",
    "cost",
    "pricing",
    "compaction"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-request-stats/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/dusklight/pi-request-stats/v1.0.0/assets/gallery-card.png"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run typecheck && npm test",
    "pack:list": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dusklight/pi-request-stats.git"
  },
  "homepage": "https://github.com/dusklight/pi-request-stats#readme",
  "bugs": {
    "url": "https://github.com/dusklight/pi-request-stats/issues"
  }
}
